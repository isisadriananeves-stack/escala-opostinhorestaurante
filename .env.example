# Copie para .env.local (para rodar no seu computador) ou cadastre na Vercel
# em Settings > Environment Variables. No Supabase, botão Connect > Framework > Next.js:
# copie as duas linhas do .env.local. (O nome antigo NEXT_PUBLIC_SUPABASE_ANON_KEY também funciona.)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Entrega 3 · API de ponto (Pontomais)
# Os valores reais ficam SÓ na Vercel (Settings > Environment Variables), nunca neste arquivo.
# Este arquivo vai para o GitHub: aqui só textos de exemplo.
# PONTO_API_URL: endereço da API do Pontomais (ex.: https://api.pontomais.com.br)
# PONTO_API_TOKEN: "Token público" do painel Pontomais (Marketplace > API Pontomais). Guarde como Sensitive.
PONTO_API_URL=coloque_aqui_a_url_da_api
PONTO_API_TOKEN=coloque_aqui

# Botão "Sugerir escala" · API da Anthropic (Claude)
# A chave real fica SÓ na Vercel (Settings > Environment Variables), nunca neste arquivo.
ANTHROPIC_API_KEY=coloque_aqui
